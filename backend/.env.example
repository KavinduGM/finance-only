# Copy to backend/.env for local development.
# On Dokploy, set these in the application's Environment tab instead.

NODE_ENV=production
PORT=3001

# Where the database, uploaded receipts/logo and backups are stored.
# In Docker this is the mounted volume (/data). Leave unset locally (uses backend/data).
# DATA_DIR=/data

# First administrator. Used ONLY when the database has no users yet.
# The password needs 10+ characters with letters and numbers.
# If ADMIN_PASSWORD is left empty, a random one is printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Business timezone: "today", due dates and the 9 AM reminder emails follow it.
APP_TIMEZONE=Asia/Colombo

# Public address of the system (no trailing slash), e.g. https://finance.example.com
APP_URL=

# Number of reverse proxies in front of the app: 1 behind Dokploy/Traefik
# (the Docker image sets this), 0 when the port is reached directly.
# TRUST_PROXY=0

# How long a sign-in lasts, and how many automatic daily backups to keep.
SESSION_DAYS=7
BACKUP_KEEP=14

# Email through Resend (https://resend.com). Invoices, proposals, payment
# reminders and salary slips are sent with this key. It is read from the
# environment only: never stored in the database, never sent to the browser.
RESEND_API_KEY=
# Sender. Must be an address on a domain you verified in Resend.
# Either "Name <address>" or just the address.
EMAIL_FROM=
# Optional: where replies go (defaults to the company email from Settings).
EMAIL_REPLY_TO=
# Set to true on a demo or test copy that runs on real data, so it can never
# email real clients (reminders included).
EMAIL_DISABLED=false

# Optional alternative to Resend: an SMTP mailbox. Normally entered in
# Settings → Email; these are used only while those fields are empty.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
